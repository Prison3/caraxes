<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Caraxes" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pine</item>
        <item name="colorOnPrimary">@color/paper2</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/paper2</item>
        <item name="colorSurface">@color/paper2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorError">@color/cinnabar</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:statusBarColor">@color/pine</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="materialButtonStyle">@style/Widget.Caraxes.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Caraxes.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Caraxes.Dialog</item>
        <item name="dialogCornerRadius">24dp</item>
        <item name="chipStyle">@style/Widget.Caraxes.Chip</item>
    </style>

    <style name="Widget.Caraxes.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/pine</item>
        <item name="android:textColor">@color/paper2</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Caraxes.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/pine</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Caraxes.Button.Ghost.Compact" parent="Widget.Caraxes.Button.Ghost">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Caraxes.Button.Ghost.Danger" parent="Widget.Caraxes.Button.Ghost.Compact">
        <item name="android:textColor">@color/cinnabar</item>
        <item name="strokeColor">@color/cinnabar</item>
    </style>

    <style name="Widget.Caraxes.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/paper2</item>
        <item name="android:textColor">@color/pine</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">13sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Caraxes.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/pine</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/pine</item>
        <item name="startIconTint">@color/ink_soft</item>
        <item name="android:textColorHint">@color/ink_soft</item>
    </style>

    <style name="ThemeOverlay.Caraxes.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/pine</item>
        <item name="colorSurface">@color/paper2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="dialogCornerRadius">24dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Caraxes.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Caraxes.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Caraxes.Dialog.Negative</item>
    </style>

    <style name="ShapeAppearance.Caraxes.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Caraxes.Dialog.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/pine</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Caraxes.Dialog.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Caraxes.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">10dp</item>
    </style>

    <style name="Form" />

    <style name="Form.Label" parent="Form">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text" />

    <style name="Text.PageTitle" parent="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/pine</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.SectionTitle" parent="Text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/pine</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Empty" parent="Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">24dp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
