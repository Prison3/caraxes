<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Text.PageTitle"
            android:text="管理" />

        <TextView
            style="@style/Text.PageSubtitle"
            android:text="添加、改名、删除店铺和供应商" />

        <TextView
            style="@style/Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:text="店铺" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/newShopName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="店铺名称"
                android:inputType="text"
                android:maxLength="200"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_soft"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addShopBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="添加"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/shopMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/shopList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            style="@style/Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_weight="0"
            android:text="供应商" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/newSupplierName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="供应商名称"
                android:inputType="text"
                android:maxLength="200"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_soft"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addSupplierBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="添加"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/supplierMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/supplierList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:text="最近删除" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearDeletionsBtn"
                style="@style/Widget.Caraxes.Button.Ghost.Danger"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="清空"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/deletionMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/deletionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/deletionEmpty"
            style="@style/Text.Empty"
            android:text="暂无删除记录" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
