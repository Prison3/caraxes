<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/editOrderMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            style="@style/Form.Label"
            android:text="店铺名" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/editShopChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Caraxes.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="日期">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editOrderDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Form.Label"
            android:layout_marginTop="12dp"
            android:text="供应商名" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/editSupplierChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Caraxes.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="单日总金额">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDailyTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
