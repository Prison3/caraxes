<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/Text.PageTitle"
        android:text="用户管理" />

    <TextView
        style="@style/Text.PageSubtitle"
        android:text="管理店长账号：添加、改绑店铺、启用/禁用、删除" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="搜索用户名或店铺"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchBtn"
            style="@style/Widget.Caraxes.Button.Ghost.Compact"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="搜索" />
    </LinearLayout>

    <TextView
        android:id="@+id/staffMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/emptyText"
            style="@style/Text.Empty"
            android:layout_gravity="center"
            android:text="暂无店长账号，点击下方添加"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="添加店长"
        android:textSize="16sp" />
</LinearLayout>
