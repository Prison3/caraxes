<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/Text.PageTitle"
        android:text="成本" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Form.Label"
                    android:text="查看" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/groupByGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/groupShop"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/groupShop"
                        style="@style/Widget.Caraxes.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="按店铺" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/groupSupplier"
                        style="@style/Widget.Caraxes.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="按供应商" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/filterLabel"
                    style="@style/Form.Label"
                    android:layout_marginTop="12dp"
                    android:text="店铺" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/filterChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true" />

                <TextView
                    style="@style/Form.Label"
                    android:layout_marginTop="12dp"
                    android:text="时间" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/periodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/periodMonth"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/periodDay"
                        style="@style/Widget.Caraxes.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="按日" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/periodMonth"
                        style="@style/Widget.Caraxes.ToggleButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="按月" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/queryBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="查询" />

                <TextView
                    android:id="@+id/costMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chartHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chartPrev"
                    style="@style/Widget.Caraxes.Button.Ghost.Compact"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:text="‹"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/chartTitle"
                    style="@style/Text.SectionTitle"
                    android:gravity="center"
                    android:text="日柱状" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chartNext"
                    style="@style/Widget.Caraxes.Button.Ghost.Compact"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:text="›"
                    android:textSize="18sp" />
            </LinearLayout>

            <com.caraxes.app.ui.cost.CostBarChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.SectionTitle"
                    android:text="成本汇总" />

                <TextView
                    android:id="@+id/listMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_soft"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sumMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/pine"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/costList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/emptyHint"
                style="@style/Text.Empty"
                android:text="暂无成本数据" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
